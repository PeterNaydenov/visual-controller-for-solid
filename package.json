{
  "name": "@peter.naydenov/visual-controller-for-solid",
  "description": "Tool for building micro-frontends(MFE) based on Solid components - Start multiple Solid applications on the same HTML page and control them",
  "version": "2.0.2",
  "license": "MIT",
  "author": "Peter Naydenov",
  "type": "module",
  "main": "src/main.js",
  "module": "dist/visual-controller-for-solid.esm.js",
  "types": "./dist/index.d.ts",
  "unpkg": "dist/visual-controller-for-solid.umd.js",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=16.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/visual-controller-for-solid.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/visual-controller-for-solid.cjs"
      },
      "default": "./dist/visual-controller-for-solid.esm.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run types",
    "types": "tsc -p tsconfig.types.json && node scripts/generate-cjs-types.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "cover": "vitest run --coverage"
  },
  "dependencies": {
    "ask-for-promise": "^3.2.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/visual-controller-for-solid.git"
  },
  "homepage": "https://github.com/PeterNaydenov/visual-controller-for-solid#readme",
  "bugs": {
    "url": "https://github.com/PeterNaydenov/visual-controller-for-solid/issues"
  },
  "keywords": [
    "solid",
    "micro-frontend",
    "MFE",
    "visual controller"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
